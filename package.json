{
  "name": "fintracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:build": "tsc -p api/tsconfig.json",
    "api:package": "node scripts/package-api.mjs && pnpm api:build",
    "api:dev": "pnpm api:build && cd api && func start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "tsx scripts/local-db.ts",
    "data:normalize": "tsx scripts/normalize.ts",
    "data:import": "tsx api/src/import.ts",
    "check:public": "tsx scripts/check-public.ts",
    "test:browser": "tsx scripts/browser-check.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.8.0",
    "@azure/msal-browser": "^4.0.0",
    "@prisma/client": "^6.19.3",
    "jose": "^6.1.0",
    "next": "16.2.6",
    "papaparse": "^5.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/papaparse": "^5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "prisma": "^6.19.0",
    "playwright": "^1.58.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2"
  }
}
